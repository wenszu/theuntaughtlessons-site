rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInWithEmail() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string;
    }

    function isSelfUserDocument(userId) {
      return signedIn() && (
        request.auth.uid == userId ||
        (signedInWithEmail() && request.auth.token.email.lower() == userId.lower())
      );
    }

    function isAdmin() {
      return signedInWithEmail() &&
        (
          request.auth.token.email.lower() in ['wenszu@gmail.com'] ||
          get(/databases/$(database)/documents/authorized_members/$(request.auth.token.email.lower())).data.role in ['admin', 'owner']
        );
    }

    function isBootstrapOwner() {
      return signedInWithEmail() &&
        request.auth.token.email.lower() in ['wenszu@gmail.com'];
    }

    function isBootstrapOwnerEmail(email) {
      return email.lower() in ['wenszu@gmail.com'];
    }

    function isCanonicalMemberRecord(email) {
      return email == email.lower() &&
        request.resource.data.email is string &&
        request.resource.data.email == email;
    }

    function isValidAccessRequest(requestId) {
      return requestId == requestId.lower() &&
        request.resource.data.keys().hasOnly([
          'fullName', 'email', 'notes', 'status', 'requestedAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 1 &&
        request.resource.data.fullName.size() <= 200 &&
        request.resource.data.email is string &&
        request.resource.data.email == requestId &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 2000 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedAt == request.time;
    }

    function isValidAssessmentItemAttempt(attemptId) {
      return signedIn() &&
        attemptId.size() >= 8 &&
        attemptId.size() <= 160 &&
        request.resource.data.keys().hasOnly([
          'userId', 'assessment', 'bankRelease', 'rubricVersion', 'formId',
          'totalScore', 'items', 'completedAt', 'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.assessment in ['diagnostic', 'checkpoint'] &&
        request.resource.data.bankRelease is string &&
        request.resource.data.bankRelease.size() <= 80 &&
        request.resource.data.rubricVersion is string &&
        request.resource.data.rubricVersion.size() <= 120 &&
        request.resource.data.formId is string &&
        request.resource.data.formId.size() <= 20 &&
        request.resource.data.totalScore is number &&
        request.resource.data.totalScore >= 0 &&
        request.resource.data.totalScore <= 100 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() <= 45 &&
        request.resource.data.completedAt is string &&
        request.resource.data.completedAt.size() <= 80 &&
        request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSelfUserDocument(userId) || isAdmin();
      allow write: if isSelfUserDocument(userId) || isAdmin();
    }

    match /users/{userId}/completed_exercises/{exerciseId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }

    match /assessment_item_attempts/{attemptId} {
      allow read: if isAdmin();
      allow create: if isValidAssessmentItemAttempt(attemptId);
      allow update: if isValidAssessmentItemAttempt(attemptId) &&
        resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /assessment_item_reviews/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /tsa_scoring_comparisons/{attemptId} {
      allow create, update: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'userId', 'attemptId', 'assessment', 'formId', 'rubricVersion',
          'enabled', 'officialSource', 'deterministic', 'genAi', 'difference',
          'modelVersion', 'completedAt', 'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.attemptId == attemptId &&
        request.resource.data.assessment in ['diagnostic', 'checkpoint'] &&
        request.resource.data.formId is string &&
        request.resource.data.formId.size() <= 20 &&
        request.resource.data.rubricVersion is string &&
        request.resource.data.rubricVersion.size() <= 120 &&
        request.resource.data.modelVersion is string &&
        request.resource.data.modelVersion.size() <= 160 &&
        request.resource.data.completedAt is string &&
        request.resource.data.completedAt.size() <= 80 &&
        request.resource.data.updatedAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /authorized_members/{email} {
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        isCanonicalMemberRecord(email) &&
        (!isBootstrapOwnerEmail(email) || isBootstrapOwner());
      allow delete: if isAdmin() && !isBootstrapOwnerEmail(email);
      // Members can update only their own preferred name and login timestamps.
      allow update: if signedInWithEmail() &&
        request.auth.token.email.lower() == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastLoginAt', 'firstLoginAt']);
    }

    // Public credentials intentionally contain only verification-safe fields.
    // Issuance records and all writes are handled by trusted server functions.
    match /public_credentials/{credentialId} {
      allow read: if true;
      allow write: if false;
    }

    match /credential_issuance/{issuanceId} {
      allow read, write: if false;
    }

    match /access_requests/{requestId} {
      allow create: if isValidAccessRequest(requestId);
      allow read, update, delete: if isAdmin();
    }

    match /google_group_sync_jobs/{jobId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if docId in ['publicSite', 'public_assessments'] ||
        (signedIn() && docId in ['feedback', 'engagement', 'rewards', 'tsa_scoring']) ||
        isAdmin();
      allow write: if isAdmin();
    }
  }
}
