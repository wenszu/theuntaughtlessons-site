rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInWithEmail() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string;
    }

    function isSelfUserDocument(userId) {
      return signedIn() && (
        request.auth.uid == userId ||
        (signedInWithEmail() && request.auth.token.email.lower() == userId.lower())
      );
    }

    function validAnalyticsSeconds(value) {
      return value is int && value >= 0 && value <= 43200;
    }

    function validAnalyticsCommon(userId) {
      return request.resource.data.userId == userId &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.sessionId is string && request.resource.data.sessionId.size() >= 8 && request.resource.data.sessionId.size() <= 100 &&
        request.resource.data.lastMeaningfulAtMs is int && request.resource.data.lastMeaningfulAtMs >= 0 &&
        validAnalyticsSeconds(request.resource.data.elapsedSeconds) &&
        validAnalyticsSeconds(request.resource.data.activeSeconds) &&
        validAnalyticsSeconds(request.resource.data.idleSeconds) &&
        validAnalyticsSeconds(request.resource.data.hiddenSeconds) &&
        request.resource.data.meaningfulInteractions is int && request.resource.data.meaningfulInteractions >= 0 && request.resource.data.meaningfulInteractions <= 100000 &&
        request.resource.data.progressPercent is int && request.resource.data.progressPercent >= 0 && request.resource.data.progressPercent <= 100 &&
        request.resource.data.deviceClass in ['mobile', 'tablet', 'desktop'] &&
        request.resource.data.activityId is string && request.resource.data.activityId.size() <= 100 &&
        request.resource.data.activityTitle is string && request.resource.data.activityTitle.size() <= 160 &&
        request.resource.data.lastStepId is string && request.resource.data.lastStepId.size() <= 100 &&
        request.resource.data.completed is bool && request.resource.data.resumed is bool &&
        request.resource.data.exitReason in ['', 'pagehide', 'completed'] &&
        request.resource.data.helpOpenedCount is int && request.resource.data.helpOpenedCount >= 0 && request.resource.data.helpOpenedCount <= 10000 &&
        request.resource.data.validationErrorCount is int && request.resource.data.validationErrorCount >= 0 && request.resource.data.validationErrorCount <= 10000 &&
        request.resource.data.submitCount is int && request.resource.data.submitCount >= 0 && request.resource.data.submitCount <= 10000 &&
        request.resource.data.restartCount is int && request.resource.data.restartCount >= 0 && request.resource.data.restartCount <= 10000 &&
        request.resource.data.lastEventName in ['activity_opened', 'working_started', 'help_opened', 'validation_failed', 'submitted', 'restarted', 'completed'] &&
        request.resource.data.receivedAt == request.time;
    }

    function isAdmin() {
      return signedInWithEmail() &&
        (
          request.auth.token.email.lower() in ['wenszu@gmail.com'] ||
          get(/databases/$(database)/documents/authorized_members/$(request.auth.token.email.lower())).data.role in ['admin', 'owner']
        );
    }

    function isBootstrapOwner() {
      return signedInWithEmail() &&
        request.auth.token.email.lower() in ['wenszu@gmail.com'];
    }

    function isBootstrapOwnerEmail(email) {
      return email.lower() in ['wenszu@gmail.com'];
    }

    function isCanonicalMemberRecord(email) {
      return email == email.lower() &&
        request.resource.data.email is string &&
        request.resource.data.email == email;
    }

    function isValidAccessRequest(requestId) {
      return requestId == requestId.lower() &&
        request.resource.data.keys().hasOnly([
          'fullName', 'email', 'notes', 'status', 'requestedAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 1 &&
        request.resource.data.fullName.size() <= 200 &&
        request.resource.data.email is string &&
        request.resource.data.email == requestId &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 2000 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedAt == request.time;
    }

    function isValidAssessmentItemAttempt(attemptId) {
      return signedIn() &&
        attemptId.size() >= 8 &&
        attemptId.size() <= 160 &&
        request.resource.data.keys().hasOnly([
          'userId', 'assessment', 'bankRelease', 'rubricVersion', 'formId',
          'totalScore', 'items', 'completedAt', 'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.assessment in ['diagnostic', 'checkpoint'] &&
        request.resource.data.bankRelease is string &&
        request.resource.data.bankRelease.size() <= 80 &&
        request.resource.data.rubricVersion is string &&
        request.resource.data.rubricVersion.size() <= 120 &&
        request.resource.data.formId is string &&
        request.resource.data.formId.size() <= 20 &&
        request.resource.data.totalScore is number &&
        request.resource.data.totalScore >= 0 &&
        request.resource.data.totalScore <= 100 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() <= 45 &&
        request.resource.data.completedAt is string &&
        request.resource.data.completedAt.size() <= 80 &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidExerciseAttempt(userId, attemptId) {
      return signedIn() && request.auth.uid == userId &&
        attemptId.size() >= 8 && attemptId.size() <= 100 &&
        request.resource.data.keys().hasOnly([
          'schemaVersion', 'userId', 'attemptId', 'exerciseId', 'exerciseTitle',
          'contentVersion', 'score', 'scoreMaximum', 'scorePercent',
          'attemptNumber', 'durationSeconds', 'submittedAt', 'createdAt'
        ]) &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.userId == userId &&
        request.resource.data.attemptId == attemptId &&
        request.resource.data.exerciseId is string && request.resource.data.exerciseId.size() >= 1 && request.resource.data.exerciseId.size() <= 100 &&
        request.resource.data.exerciseTitle is string && request.resource.data.exerciseTitle.size() >= 1 && request.resource.data.exerciseTitle.size() <= 160 &&
        request.resource.data.contentVersion is string && request.resource.data.contentVersion.size() <= 80 &&
        request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1000 &&
        request.resource.data.scoreMaximum is int && request.resource.data.scoreMaximum >= 1 && request.resource.data.scoreMaximum <= 1000 &&
        request.resource.data.score <= request.resource.data.scoreMaximum &&
        request.resource.data.scorePercent is int && request.resource.data.scorePercent >= 0 && request.resource.data.scorePercent <= 100 &&
        request.resource.data.attemptNumber is int && request.resource.data.attemptNumber >= 1 && request.resource.data.attemptNumber <= 10000 &&
        validAnalyticsSeconds(request.resource.data.durationSeconds) &&
        request.resource.data.submittedAt == request.time && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSelfUserDocument(userId) || isAdmin();
      allow write: if isSelfUserDocument(userId) || isAdmin();
    }

    match /users/{userId}/completed_exercises/{exerciseId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }

    match /users/{userId}/exercise_attempts/{attemptId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if isValidExerciseAttempt(userId, attemptId);
      allow update, delete: if false;
    }

    match /users/{userId}/analytics_sessions/{sessionId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'userId', 'schemaVersion', 'sessionId', 'startedAtClient', 'updatedAtClient',
          'lastMeaningfulAtClient', 'lastMeaningfulAtMs', 'elapsedSeconds', 'activeSeconds',
          'idleSeconds', 'hiddenSeconds', 'meaningfulInteractions', 'deviceClass', 'pagePath',
          'activityId', 'activityType', 'activityTitle', 'lastStepId', 'progressPercent',
          'completed', 'resumed', 'exitReason', 'endedAtClient', 'helpOpenedCount',
          'validationErrorCount', 'submitCount', 'restartCount', 'lastEventName', 'receivedAt'
        ]) && request.resource.data.sessionId == sessionId && validAnalyticsCommon(userId);
      allow delete: if false;
    }

    match /users/{userId}/analytics_activity_sessions/{activitySessionId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'userId', 'activitySessionId', 'schemaVersion', 'sessionId', 'startedAtClient', 'updatedAtClient',
          'lastMeaningfulAtClient', 'lastMeaningfulAtMs', 'elapsedSeconds', 'activeSeconds',
          'idleSeconds', 'hiddenSeconds', 'meaningfulInteractions', 'deviceClass', 'pagePath',
          'activityId', 'activityType', 'activityTitle', 'lastStepId', 'progressPercent',
          'completed', 'resumed', 'exitReason', 'endedAtClient', 'helpOpenedCount',
          'validationErrorCount', 'submitCount', 'restartCount', 'lastEventName', 'receivedAt'
        ]) && request.resource.data.activitySessionId == activitySessionId && validAnalyticsCommon(userId);
      allow delete: if false;
    }

    match /assessment_item_attempts/{attemptId} {
      allow read: if isAdmin();
      allow create: if isValidAssessmentItemAttempt(attemptId);
      allow update: if isValidAssessmentItemAttempt(attemptId) &&
        resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /assessment_item_reviews/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /tsa_scoring_comparisons/{attemptId} {
      allow create, update: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'userId', 'attemptId', 'assessment', 'formId', 'rubricVersion',
          'enabled', 'officialSource', 'deterministic', 'genAi', 'difference',
          'modelVersion', 'completedAt', 'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.attemptId == attemptId &&
        request.resource.data.assessment in ['diagnostic', 'checkpoint'] &&
        request.resource.data.formId is string &&
        request.resource.data.formId.size() <= 20 &&
        request.resource.data.rubricVersion is string &&
        request.resource.data.rubricVersion.size() <= 120 &&
        request.resource.data.modelVersion is string &&
        request.resource.data.modelVersion.size() <= 160 &&
        request.resource.data.completedAt is string &&
        request.resource.data.completedAt.size() <= 80 &&
        request.resource.data.updatedAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /authorized_members/{email} {
      allow read: if isAdmin() || (
        signedInWithEmail() && request.auth.token.email.lower() == email.lower()
      );
      allow create, update: if isAdmin() &&
        isCanonicalMemberRecord(email) &&
        (!isBootstrapOwnerEmail(email) || isBootstrapOwner());
      allow delete: if isAdmin() && !isBootstrapOwnerEmail(email);
      // Members can update only their own preferred name and login audit fields.
      allow update: if signedInWithEmail() &&
        request.auth.token.email.lower() == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'lastLoginAt', 'firstLoginAt', 'lastSignInProvider', 'signInProviders'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSignInProvider']) ||
          request.resource.data.lastSignInProvider in ['emailLink', 'google.com', 'microsoft.com', 'facebook.com', 'password']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['signInProviders']) ||
          (request.resource.data.signInProviders is list && request.resource.data.signInProviders.size() <= 5));
    }

    // Public credentials intentionally contain only verification-safe fields.
    // Issuance records and all writes are handled by trusted server functions.
    match /public_credentials/{credentialId} {
      allow read: if true;
      allow write: if false;
    }

    match /credential_issuance/{issuanceId} {
      allow read, write: if false;
    }

    match /access_requests/{requestId} {
      allow create: if isValidAccessRequest(requestId);
      allow read, update, delete: if isAdmin();
    }

    match /google_group_sync_jobs/{jobId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /support_preview_audit/{eventId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /settings/{docId} {
      allow read: if docId in ['publicSite', 'public_assessments'] ||
        (signedIn() && docId in ['feedback', 'engagement', 'rewards', 'tsa_scoring']) ||
        isAdmin();
      allow write: if isAdmin();
    }
  }
}
